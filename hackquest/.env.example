# HackQuest CTF 2026 - environment template
# Copy to .env and replace every placeholder. NEVER commit the real .env.

# ---- Core ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=0

# PostgreSQL connection string (docker-compose builds this for you).
# Local development may use: sqlite:///./hackquest.db
DATABASE_URL=postgresql+psycopg2://hackquest:CHANGE_ME@db:5432/hackquest

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTER_STRING

# Comma-separated origins permitted to call the API with credentials.
# Leave empty when the SPA is served by the same origin.
ALLOWED_ORIGINS=

# ---- Database bootstrap (used by docker-compose) --------------------------
POSTGRES_DB=hackquest
POSTGRES_USER=hackquest
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Host port exposed by docker compose
APP_PORT=8000

# ---- Competition --------------------------------------------------------
PROCTOR_VIOLATION_LIMIT=3
HINT_PENALTY=0
SUBMIT_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10
HINT_RATE_LIMIT=20
SESSION_MAX_AGE=43200

# ---- Argon2id password hashing -------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ---- Organizer bootstrap (optional; the CLI is preferred) ----------------
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=

# ---- Email verification (OPTIONAL - leave blank to disable) -------------
# With no SMTP settings, teams are treated as verified automatically and
# password recovery cannot send mail. This is NOT a working integration
# until real credentials are supplied.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=