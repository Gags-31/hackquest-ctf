* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Segoe UI', Arial, sans-serif; background: #0d1117; color: #e6edf3; line-height: 1.6; }
header { background: linear-gradient(135deg, #161b22, #1f2a3a); padding: 40px 20px; text-align: center; border-bottom: 2px solid #2ea043; }
header h1 { font-size: 2.6rem; color: #2ea043; }
header p { color: #8b949e; }
nav { background: #161b22; padding: 12px; text-align: center; position: sticky; top: 0; }
nav a { color: #58a6ff; text-decoration: none; margin: 0 12px; font-size: 0.95rem; }
nav a:hover { text-decoration: underline; }
main { max-width: 1000px; margin: 30px auto; padding: 0 20px; }
section { margin-bottom: 40px; }
h2 { color: #2ea043; margin-bottom: 12px; border-bottom: 1px solid #30363d; padding-bottom: 6px; }
table { width: 100%; border-collapse: collapse; margin: 15px 0; }
th, td { border: 1px solid #30363d; padding: 8px 12px; text-align: left; }
th { background: #161b22; color: #2ea043; }
tr:nth-child(even) { background: #161b22; }
.badge { padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; }
.easy { background: #238636; } .medium { background: #9e6a03; } .advanced { background: #1f6feb; } .hard { background: #da3633; }
footer { text-align: center; padding: 20px; color: #8b949e; border-top: 1px solid #30363d; margin-top: 40px; }
ul { padding-left: 22px; }
