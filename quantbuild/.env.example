# ── QuantBuild configuration ──────────────────────────────────────────────
# Everything is optional. With no LLM configured, QuantBuild runs in
# deterministic offline mode and the entire pipeline still works.

# LLM provider: auto | offline | openai | anthropic | ollama
LLM_PROVIDER=auto

# OpenAI / OpenAI-compatible (Azure, Groq, OpenRouter, LM Studio, ...)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434

# Model override (sensible defaults per provider otherwise)
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=120

# Autonomous debugging loop iterations
# MAX_DEBUG_ITERATIONS=3

# Sandbox preview port range
# PREVIEW_PORT_START=9100
# PREVIEW_PORT_END=9199
